# ─── Required in production ───────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public origin where the app is served. Used for callback URLs.
BETTER_AUTH_URL=https://cadmous.example.com

# Public origin used in sitemap.xml + robots.txt + canonical metadata.
NEXT_PUBLIC_SERVER_URL=https://cadmous.example.com

# ─── Required for admin's Translate button ────────────────────────────────
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────
# Override the SQLite file location. Defaults to file:./data/cadmous.db.
# In Docker this should be a path inside the mounted /app/data volume.
DATABASE_URL=file:./data/cadmous.db

# Salt for hashing client IPs in form-submission rate limiting + audit. Any
# stable random string is fine; do not change it once set.
IP_HASH_SALT=

# ─── Initial admin (one-time seeding) ─────────────────────────────────────
# Read by scripts/seed-admin.ts when present; otherwise the script prompts
# interactively. Safe to remove after the first run.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
